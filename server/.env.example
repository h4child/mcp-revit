# URL do bridge executado dentro do Revit. Deve permanecer em localhost.
REVIT_MCP_URL=http://127.0.0.1:14733/rpc

# Tempo limite de uma chamada MCP para o Revit, em segundos.
REVIT_MCP_TIMEOUT=120

# Deixe desativado; bridge remoto exige uma implantação com TLS e auditoria.
REVIT_MCP_ALLOW_REMOTE=0

# Opcional. Normalmente o token é gerado e lido automaticamente.
# REVIT_MCP_TOKEN=
