<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>RevitMcp</AssemblyName>
    <RootNamespace>RevitMcp</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Caminho fixo usado pelo manifesto .addin, independente da plataforma escolhida. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Version>1.1.0</Version>
    <UseWindowsForms>false</UseWindowsForms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <RevitApiDir Condition="'$(REVIT_API_DIR)' != ''">$(REVIT_API_DIR)</RevitApiDir>
    <RevitApiDir Condition="'$(RevitApiDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitApiDir>
  </PropertyGroup>

  <!--
    Sem o Revit instalado (CI, máquina de build), compila contra os assemblies de
    referência da API publicados no NuGet. Eles não são copiados para a saída: em
    execução, o Revit fornece RevitAPI.dll/RevitAPIUI.dll.
  -->
  <PropertyGroup>
    <UseRevitApiPackages Condition="'$(UseRevitApiPackages)' == '' And !Exists('$(RevitApiDir)\RevitAPI.dll')">true</UseRevitApiPackages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseRevitApiPackages)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseRevitApiPackages)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
